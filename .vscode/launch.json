    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            // "program": "${workspaceFolder}/finrl/train.py",
            "program": "finrl/train.py",
            "console": "integratedTerminal",
            "args": [
                // "${command:pickArgs}"
                "--drl_lib",
                "stable_baselines3"
            ],
            "env": {
                    "PYTHONPATH": "${workspaceFolder}"
            }
        },
    ]
}